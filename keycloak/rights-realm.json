{
  "realm": "rights",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read titles, windows and availability" },
      { "name": "editor", "description": "Create titles" },
      { "name": "rights-manager", "description": "Create license windows" }
    ]
  },
  "clients": [
    {
      "clientId": "rights-web",
      "name": "Rights Catalog web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:4200/*" }
    }
  ],
  "users": [
    {
      "username": "viewer", "enabled": true, "email": "viewer@example.test", "emailVerified": true,
      "firstName": "Vera", "lastName": "Viewer",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["viewer"]
    },
    {
      "username": "editor", "enabled": true, "email": "editor@example.test", "emailVerified": true,
      "firstName": "Eddie", "lastName": "Editor",
      "credentials": [{ "type": "password", "value": "editor", "temporary": false }],
      "realmRoles": ["viewer", "editor"]
    },
    {
      "username": "manager", "enabled": true, "email": "manager@example.test", "emailVerified": true,
      "firstName": "Maya", "lastName": "Manager",
      "credentials": [{ "type": "password", "value": "manager", "temporary": false }],
      "realmRoles": ["viewer", "rights-manager"]
    }
  ]
}
